{
  "name": "khotwa-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android and iOS app shell for Khotwa. It opens the website inside a native container and adds the phone's scanner, location and update features.",
  "scripts": {
    "www": "node scripts/build-www.mjs",
    "add:android": "node scripts/build-www.mjs && cap add android && node scripts/prepare.mjs android",
    "add:ios": "node scripts/build-www.mjs && node scripts/add-ios.mjs",
    "sync": "node scripts/build-www.mjs && cap sync",
    "verify:android": "node scripts/verify.mjs android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor-community/background-geolocation": "^1.2.0",
    "@capacitor-mlkit/barcode-scanning": "^8.0.0",
    "@capawesome/capacitor-app-update": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
